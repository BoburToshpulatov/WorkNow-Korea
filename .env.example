# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
# - With password auth:        postgresql://postgres:postgres@localhost:5432/worknow_korea?schema=public
# - With trust auth (no pw):   postgresql://youruser@localhost:5433/worknow_korea?schema=public
# A local Homebrew Postgres typically uses your macOS username with trust auth.
# See README → "Local Login Setup" if login fails.
DATABASE_URL="postgresql://youruser@localhost:5433/worknow_korea?schema=public"

# NextAuth / Auth.js — MUST be a real non-empty value, or login throws
# a "Configuration" error. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Auth.js v5 reads AUTH_SECRET — keep it the same as NEXTAUTH_SECRET
AUTH_SECRET="replace-with-a-long-random-string"

# ── Notifications ────────────────────────────────────────────────────
# Active external provider: mock | sms | kakao. Default mock (no real sends).
# In-app/inbox notifications are always real regardless of this flag.
NOTIFICATION_PROVIDER="mock"
# SMS provider (e.g. Coolsms / Solapi). Blank → degrades to MOCKED safely.
SMS_PROVIDER_KEY=""
SMS_PROVIDER_SECRET=""
SMS_SENDER_PHONE=""
# KakaoTalk Alimtalk (알림톡):
KAKAO_API_KEY=""

# ── Production readiness (Phase: ops hardening) ───────────────────────
# APP_ENV gates unsafe defaults. production REQUIRES UPLOAD_STORAGE=s3,
# a real https APP_URL, and a non-placeholder AUTH_SECRET.
APP_ENV="development"          # development | staging | production
APP_URL="http://localhost:3000"

# Document storage. local = dev/staging only; production must use s3.
UPLOAD_STORAGE="local"        # local | s3
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_S3_PRIVATE_PREFIX="verification/"

# Document retention (days). Reviewed by Korean counsel before launch (PIPA).
DOCUMENT_RETENTION_DAYS="90"
REJECTED_DOCUMENT_RETENTION_DAYS="14"

# Error monitoring (Sentry placeholder).
ENABLE_ERROR_MONITORING="false"
SENTRY_DSN=""

# Logging: debug | info | warn | error
LOG_LEVEL="info"

# ── Rate limiting (Phase: deployability) ──────────────────────────────
RATE_LIMIT_PROVIDER="memory"   # memory (dev) | redis (production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── S3-compatible storage extras (AWS S3 / Cloudflare R2 / DO Spaces) ──
S3_ENDPOINT=""                 # optional: R2/Spaces endpoint
S3_FORCE_PATH_STYLE="false"    # optional: true for some S3-compatibles

# ── Scheduled cleanup ─────────────────────────────────────────────────
CRON_SECRET=""                 # required to call /api/cron/documents-cleanup

# ── SMS vendor (Phase: worker pilot) ──────────────────────────────────
SMS_PROVIDER="solapi"          # solapi | coolsms | generic
# SMS_PROVIDER_KEY / SMS_PROVIDER_SECRET / SMS_SENDER_PHONE already above.
SMS_API_BASE_URL=""            # optional override (generic adapter / self-host)
